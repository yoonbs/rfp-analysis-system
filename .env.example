# ----------------------------------------------------------------------
# .env.example  ->  복사해서 .env 로 만든 뒤 값을 채워주세요.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
#
# Vercel 배포 시에는 이 값들을 Vercel 프로젝트의 Environment Variables 에 등록합니다.
# ----------------------------------------------------------------------

# 사용할 LLM 제공자: gemini | anthropic
LLM_PROVIDER=gemini

# --- Google Gemini ---
GEMINI_API_KEY=여기에_발급받은_키를_입력
GEMINI_MODEL=gemini-3-flash-preview

# --- Anthropic Claude (LLM_PROVIDER=anthropic 일 때 사용) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- 접근 제한 ---
# APP_PASSWORD 를 비워두면 인증 없이 동작합니다(로컬 개발용).
# 공개 배포 시에는 반드시 APP_PASSWORD 와 SECRET_KEY 를 설정하세요.
APP_PASSWORD=
# 세션 서명 키. 아래 명령으로 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- 분석 옵션 ---
# 분석에 사용할 최대 글자 수 (초과분은 잘라서 전송)
MAX_TEXT_CHARS=180000
# 보관할 최근 분석 이력 건수
HISTORY_LIMIT=50

# --- DB (선택) ---
# 비워두면 SQLite 사용. 로컬은 프로젝트 폴더, Vercel 은 /tmp(휘발성).
# Postgres 등 외부 DB를 쓰려면 접속 문자열을 지정하세요.
# DATABASE_URL=postgresql://user:pw@host/dbname?sslmode=require
